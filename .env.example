APP_BASE_URL=https://composer.your-domain.com

# Storage. Relative paths are resolved against the project root (public/index.php
# does chdir($root) at boot), not the process CWD. Use absolute paths when
# operating outside the repo (e.g. /var/lib/composer-server/zips).
STORAGE_DSN=local:./zips
# STORAGE_DSN=s3:my-bucket/composer/zips
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=        # omit for ambient credentials (EC2 instance profile, ECS task role, Lambda)
# AWS_SECRET_ACCESS_KEY=    # must be set together with AWS_ACCESS_KEY_ID or not at all

CACHE_DIR=./cache
LISTING_TTL_SECONDS=30

AUTH_USER=ci
AUTH_PASS=replace-me
